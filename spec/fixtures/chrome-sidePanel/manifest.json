{
  "name": "chrome-sidePanel",
  "version": "1.0",
  "manifest_version": 2,
  "browser_action": {
    "default_title": "Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": ["sidePanel", "<all_urls>"]
}
